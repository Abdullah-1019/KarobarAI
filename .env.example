# KarobarAI — environment variables (TRD §27)
# Copy to .env and fill in dev values. Never commit a real .env (Sec-008).

# --- Core ---
NODE_ENV=development
PORT_WEB=5173
PORT_API=4000
PORT_AI=8000
# Internal-only (TRD §8) — Docker Compose sets this to http://ai-service:8000; native dev
# defaults to localhost:PORT_AI if left blank.
AI_SERVICE_URL=

# --- Datastore (D1) ---
DATABASE_URL=postgresql://karobarai:karobarai@postgres:5432/karobarai?schema=public
REDIS_URL=redis://redis:6379

# --- Auth (TRD §7) ---
# RS256 key pair, PEM contents. DEV-ONLY generation (one-off, no OpenSSL needed):
#   node -e "const{generateKeyPairSync}=require('crypto');const{privateKey,publicKey}=generateKeyPairSync('rsa',{modulusLength:2048,publicKeyEncoding:{type:'spki',format:'pem'},privateKeyEncoding:{type:'pkcs8',format:'pem'}});console.log(privateKey.split('\n').join('\\n'));console.log(publicKey.split('\n').join('\\n'))"
# Production MUST use secrets-manager-issued values (TRD §17/§22 — AWS Secrets Manager), never
# a value generated this way and never committed here.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=604800
JWT_ISSUER=karobarai-api
JWT_AUDIENCE=karobarai-web
BCRYPT_COST=12

# --- Field-level encryption (TRD §17) ---
# DEV-ONLY generation: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Production MUST use a secrets-manager-issued key, with a rotation procedure (TRD §17).
FIELD_ENCRYPTION_KEY=

# --- Adapter mode (D2) ---
# mock (MVP default) | live
ADAPTER_MODE=mock

# --- AI / LLM (D3) ---
OPENAI_API_KEY=
LLM_PRIMARY_MODEL=gpt-4-vision-preview
LLM_FALLBACK_MODEL=gpt-3.5-turbo
RETURNS_CONFIDENCE_THRESHOLD=0.85

# --- Vision (R1.1) ---
GCP_VISION_CREDENTIALS=

# --- Payments (live mode only) ---
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_SECRET_KEY=
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=

# --- Couriers (live mode only) ---
TCS_API_KEY=
LEOPARDS_API_KEY=
TRAX_API_KEY=

# --- Messaging (live mode only) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
AWS_SNS_ACCESS_KEY_ID=
AWS_SNS_SECRET_ACCESS_KEY=
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=

# --- Maps ---
GOOGLE_MAPS_API_KEY=

# --- Object storage / CDN ---
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
CLOUDINARY_URL=
# Dev-only local object storage (MinIO), used when S3/Cloudinary creds are blank.
# host is "minio" only inside Docker Compose; native local dev (no Docker) needs a real MinIO
# server reachable at localhost — same pattern as DATABASE_URL/REDIS_URL above. MinIO ships a
# native Windows/Mac/Linux binary (no Docker required): https://min.io/download
MINIO_ROOT_USER=karobarai
MINIO_ROOT_PASSWORD=karobarai123
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=karobarai-dev

# --- Business config defaults (admin-overridable in platform_config) ---
COMMISSION_RATE_DEFAULT=0.05
RETURN_WINDOW_DAYS=14
MIN_ORDER_VALUE_PKR=100

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Observability ---
SENTRY_DSN=
