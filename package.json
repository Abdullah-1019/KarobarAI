{
  "name": "karobarai",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "20.x",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev:frontend": "pnpm --filter @karobarai/frontend dev",
    "dev:backend": "pnpm --filter @karobarai/backend dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "prisma:generate": "pnpm --filter @karobarai/backend prisma:generate",
    "prisma:migrate": "pnpm --filter @karobarai/backend prisma:migrate"
  },
  "devDependencies": {
    "prettier": "3.3.3",
    "typescript": "5.5.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@scarf/scarf",
      "bcrypt",
      "esbuild",
      "msgpackr-extract",
      "prisma"
    ]
  }
}
